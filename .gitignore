# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turbopack
.turbo

# backup files
*.bak
*.backup
*.old

# temp/debug files
# 광범위한 *.sql 무시는 Supabase 마이그레이션을 숨길 수 있으므로 migrations는 예외로 추적한다.
*.sql
!supabase/migrations/*.sql
figma_tree.json

# python
.venv/
*.py
__pycache__/

# other tools
.yoyo/

# agent runtime artifacts (review packets, QA screenshots, state files — secrets/세션 정보가 섞일 수 있어 추적 금지)
.codex/

# 디자인 레퍼런스(로컬 보관용, 빌드/배포 제외)
design_handoff_weet/

# Playwright 산출물(로컬 전용)
test-results/
playwright-report/
