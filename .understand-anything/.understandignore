# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore. Scope chosen: full application code, excluding
# agent scratch / design handoff / image+audit work dirs / one-off scripts.
# Built-in defaults already exclude: node_modules/, .git/, dist/, build/, *.lock, *.min.js

# --- Build / framework output & env ---
/.next/
/out/
/build
/coverage
.vercel/
*.tsbuildinfo
next-env.d.ts
.env
.env*.local
.DS_Store
*.pem

# --- Lockfiles & conflict copies ---
package-lock.json
package-lock_*Conflict.json
*.bak
*.backup
*.old

# --- Agent / tooling scratch dirs ---
.claude/
.codex/
.kiro/
.sisyphus/
.yoyo/
.understand-anything/
.vscode/
.cursorrules
agent-inbox/
scratch/
tmp/
